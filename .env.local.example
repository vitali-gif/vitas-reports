# ─── Supabase ────────────────────────────────────────────────────────────────
# שני אלה מוטמעים בבאנדל של הדפדפן (זו המשמעות של NEXT_PUBLIC_) — הם ציבוריים
# בהגדרה. אסור להשתמש בהם כהרשאה בשום מקום.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# סוד. נשאר בשרת בלבד. בלעדיו ה-API מחזיר 500 במקום ליפול חזרה למפתח הציבורי.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── הרשאות ──────────────────────────────────────────────────────────────────
# רשימת המיילים שנחשבים אדמין, מופרדים בפסיק. בלי זה אין אף אדמין והפאנל
# מחזיר 403 — fail-closed בכוונה. חשבונות אדמין נוצרים ידנית ב-Supabase Auth;
# ההרשמה העצמית הוסרה מהממשק ויש לכבות אותה גם בהגדרות Supabase.
ADMIN_EMAILS=you@vitas.co.il

# משמש גם לקרונים של Vercel וגם לקריאות פנימיות שרת-לשרת (x-internal-key).
CRON_SECRET=a-long-random-string

# ─── שירותים חיצוניים ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://reports.vitas.co.il
RESEND_API_KEY=
