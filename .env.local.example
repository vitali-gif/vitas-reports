# ─── Supabase ────────────────────────────────────────────────────────────────
# שני אלה מוטמעים בבאנדל של הדפדפן (זו המשמעות של NEXT_PUBLIC_) — הם ציבוריים
# בהגדרה. אסור להשתמש בהם כהרשאה בשום מקום.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# סוד. נשאר בשרת בלבד. בלעדיו ה-API מחזיר 500 במקום ליפול חזרה למפתח הציבורי.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── הרשאות ──────────────────────────────────────────────────────────────────
# אין משתנה סביבה לאדמינים. מקור האמת היחיד הוא טבלת `admins` בבסיס הנתונים
# (מיגרציה 001). הוספת אדמין:  insert into admins (email) values ('x@y.com');
# חשבונות אדמין נוצרים ידנית ב-Supabase Auth; ההרשמה העצמית כבויה גם שם.

# משמש גם לקרונים של Vercel וגם לקריאות פנימיות שרת-לשרת (x-internal-key).
CRON_SECRET=a-long-random-string

# ─── שירותים חיצוניים ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://reports.vitas.co.il
RESEND_API_KEY=
