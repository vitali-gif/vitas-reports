{
  "name": "vitas-reports",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --file app --file lib",
    "check:auth": "node scripts/check-auth-pattern.mjs",
    "test:crm": "node scripts/tests/bmby-summary.smoke.mjs && node scripts/tests/raw-store.smoke.mjs && node scripts/tests/zoho-summary.smoke.mjs && node scripts/tests/salesforce-summary.smoke.mjs",
    "test:ads": "node scripts/tests/ads-range.smoke.mjs",
    "test:meetings": "node scripts/tests/transcript-parse.smoke.mjs",
    "test:plan": "node scripts/tests/plan-gate.smoke.mjs",
    "test:backfill": "node scripts/tests/backfill-gaps.smoke.mjs",
    "test": "npm run test:crm && npm run test:ads && npm run test:meetings && npm run test:plan && npm run test:backfill",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test --grep ציבורי",
    "qa": "npm run lint && npm run check:auth && npm test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "chart.js": "^4.4.1",
    "jose": "^5.10.0",
    "lucide-react": "^1.16.0",
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35"
  }
}
